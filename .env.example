# Copia este archivo como .env y llena tus datos. NUNCA subas el .env a GitHub.

# Tu llave de la API de Claude (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Cómo quieres que te llame el asistente
ASISTENTE_NOMBRE_USUARIO=TuNombre

# Tu zona horaria (para entender "mañana a las 3pm")
ASISTENTE_ZONA_HORARIA=America/Bogota

# Modelo de Claude (opcional)
# ASISTENTE_MODELO=claude-opus-5
